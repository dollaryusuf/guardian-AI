# The deployed settlement contract address for GuardianInsurance.sol
VITE_SETTLEMENT_CONTRACT="0x8bfbB700F9514e867375267DfbDFFb5A0e6ED6D7"

# --- 0G (ZERO GRAVITY) MODULAR STACK ---
# Decentralized Storage and Data Availability nodes
VITE_OG_STORAGE_NODE="https://rpc-testnet.0g.ai"
VITE_OG_DA_CLIENT="https://da-client-testnet.0g.ai"

# 0G AI Serving / Inference endpoint for accident forensics
VITE_OG_AI_INFERENCE_ENDPOINT="https://inference-testnet.0g.ai"

# --- DEPIN MACHINE & TELEMETRY ---
# W3bstream middleware endpoint for processing sensor anomalies
VITE_W3BSTREAM_GATEWAY="https://w3bstream-testnet.iotex.io"

# Machine Identity (ioID) naming convention prefix
VITE_IOID_PREFIX="io:guardian:ii:"

# --- APP CONFIGURATION ---
# Base URL for the Forensic Dashboard
VITE_APP_DOMAIN="http://localhost:5173"

