###############################################################################
# GUARDIAN AI | DEPIN INFRASTRUCTURE CONFIGURATION
# ---------------------------------------------------------------------------
# This template defines the connectivity required for the IoTeX and 0G 
# Modular stack. Copy this to '.env' and populate with your credentials.
###############################################################################

# --- [LAYER 1] IOTEX SETTLEMENT LAYER ---
# Target: IoTeX Testnet (Babel API)
VITE_IOTEX_RPC="https://babel-api.testnet.iotex.io"
VITE_IOTEX_CHAIN_ID=4690

# The deployed GuardianInsurance.sol contract address
VITE_SETTLEMENT_CONTRACT="0x8bfbB700F9514e867375267DfbDFFb5A0e6ED6D7"

# --- [LAYER 2] 0G MODULAR STORAGE & DA ---
# Decentralized Storage nodes for forensic media archival
VITE_OG_STORAGE_NODE="https://rpc-testnet.0g.ai"
VITE_OG_DA_CLIENT="https://da-client-testnet.0g.ai"

# --- [LAYER 3] 0G AI SERVING (ORACLE) ---
# Endpoint for decentralized AI forensic inference and liability attribution
VITE_OG_AI_INFERENCE_ENDPOINT="https://inference-testnet.0g.ai"

# --- [LAYER 4] W3BSTREAM TELEMETRY GATEWAY ---
# Middleware endpoint for processing real-time machine sensor anomalies
VITE_W3BSTREAM_ENDPOINT="https://w3bstream-testnet.iotex.io"

# --- [LAYER 5] MACHINE IDENTITY (ioID) ---
# Namespace for provisioning non-spoofable DePIN hardware IDs
VITE_IOID_REGISTRY_PREFIX="io:guardian:ii:"

# --- APP CONFIGURATION ---
# The public deployment URL for the Forensic Dashboard
VITE_APP_URL="https://guardian-ai-9wof.vercel.app/"

###############################################################################
# SECURITY NOTICE:
# Never commit your actual '.env' file or private keys to version control.
# For local simulation, ensure the Oracle Node has sufficient Testnet IOTX 
# to sign 'verifyAndPay' transactions.
###############################################################################